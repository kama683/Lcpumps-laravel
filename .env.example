APP_NAME=LCpumps
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lcpumps.com

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lcpumps
DB_USERNAME=lcpumps
DB_PASSWORD=

SESSION_DRIVER=database
# 7 days — the admin panel is the only thing using sessions; matches the
# source's 7-day JWT session length instead of Laravel's 2-hour default.
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

# Dev: MAIL_MAILER=log (writes emails to storage/logs/laravel.log instead of sending)
# Prod: set to Plesk mailbox SMTP once credentials are known
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@lcpumps.com"
MAIL_FROM_NAME="${APP_NAME}"

# Recipient for contact-form notification emails
CONTACT_NOTIFY_TO=info@lcpumps.com

# Relative to storage/app (public disk is symlinked to public/storage via `storage:link`)
UPLOADS_PUBLIC_DIR=uploads
UPLOADS_PRIVATE_DIR=private-uploads

# Comma-separated IP(s) of the reverse proxy in front of PHP-FPM (Plesk's
# nginx), or "*" to trust the direct TCP peer unconditionally. Empty/unset
# is the safe default: $request->ip() then ignores X-Forwarded-For and
# reports the raw TCP peer instead of trusting a spoofable header. See
# config/trustedproxy.php and DEPLOY.md.
TRUSTED_PROXIES=

VITE_APP_NAME="${APP_NAME}"
